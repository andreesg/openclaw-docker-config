{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "controlUi": {
      "allowedOrigins": ["http://localhost:18789"]
    }
  },

  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "allowlist",
      "allowFrom": ["tg:${TELEGRAM_USER_ID}"],
      "groupPolicy": "disabled",
      "streaming": "partial"
    }
  },

  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  },

  "models": {
    "providers": {
      "openai": {
        "apiKey": "${OPENAI_API_KEY}"
      },
      "openrouter": {
        "apiKey": "${OPENROUTER_API_KEY}"
      }
    }
  },

  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.3-chat",
        "fallbacks": [
          "openai/gpt-5.2",
          "openai/gpt-5.4-mini",
          "openrouter/openrouter/auto"
        ]
      },
      "models": {
        "openai/gpt-5.3-chat": {
          "params": {
            "transport": "auto"
          }
        },
        "openai/gpt-5.2": {
          "params": {
            "transport": "auto"
          }
        },
        "openai/gpt-5.4-mini": {
          "params": {
            "transport": "auto"
          }
        },
        "openrouter/openrouter/auto": {}
      },
      "compaction": {
        "mode": "safeguard"
      },
      "maxConcurrent": 2,
      "subagents": {
        "maxConcurrent": 4
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "identity": {
          "name": "Coter",
          "emoji": "🔘"
        }
      }
    ]
  },

  "commands": {
    "native": false,
    "nativeSkills": "auto",
    "allowFrom": {
      "telegram": ["tg:${TELEGRAM_USER_ID}"]
    }
  },

  "logging": {
    "level": "info",
    "consoleLevel": "info",
    "redactSensitive": "tools"
  }
}
